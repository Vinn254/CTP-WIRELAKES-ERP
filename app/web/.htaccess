# Static rules for the app folder itself (public_html/app). The website's own .htaccess stays where it is.

# Compress the code the phone has to fetch before the app appears. The host already brotli-compresses when it
# can; this covers the plain gzip path and the file types it may otherwise serve raw.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json application/wasm image/svg+xml
</IfModule>

# The page is re-checked on every visit so a new build shows the same day. Everything the page pulls in is kept
# by the phone for a while, so a member who has opened the app once does not download it again.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/javascript "access plus 12 hours"
  ExpiresByType application/json "access plus 12 hours"
  ExpiresByType application/wasm "access plus 7 days"
  ExpiresByType image/png "access plus 7 days"
  ExpiresByType image/jpeg "access plus 7 days"
</IfModule>
