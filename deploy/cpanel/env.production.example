# Copy to web/.env on the host, then fill in the four <angle bracket> values and run
#   php artisan key:generate --force
# Nothing in this file is a real secret. Never commit the filled-in .env — it stays out of git by the root .gitignore.

APP_NAME="CTP-WireLakes"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://<domain>

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# cPanel → MySQL Databases. The host on shared cPanel is always localhost.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=<db_name>
DB_USERNAME=<db_user>
DB_PASSWORD=<db_password_from_cpanel>

SESSION_DRIVER=file
SESSION_LIFETIME=5
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
# local = uploads are written to web/storage/app/private and only served back through a signed-in controller.
FILESYSTEM_DISK=local
# sync = a job runs the moment it is dispatched, so shared hosting never needs a queue worker.
QUEUE_CONNECTION=sync

CACHE_STORE=database

# Required, not optional: an office sign-in and every new account need an emailed code, and a forgotten password
# needs an emailed link. With MAIL_MAILER=log those emails only land in storage/logs and nobody can sign in.
# cPanel → Email Accounts → create <full_cpanel_email> at your domain, then connect Devices (IMAP/SMTP) and copy
# the "SMTP: Secure SSL" port and password shown there. Port 465 goes with MAIL_SCHEME=smtps; port 587 with smtp.
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=mail.<domain>
MAIL_PORT=465
MAIL_USERNAME=<full_cpanel_email>
MAIL_PASSWORD=<that_mailboxes_password>
MAIL_FROM_ADDRESS=<full_cpanel_email>
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# The first super admin. Leave both empty for a normal install and `php artisan db:seed` creates no account at all.
# Fill them only to bootstrap the very first login, seed once, then blank them again and run php artisan config:clear.
SEED_ADMIN_EMAIL=
SEED_ADMIN_NAME="Super Admin"
SEED_ADMIN_PASSWORD=

# Over https the session cookie is only sent over TLS. Set this once the domain has its cPanel certificate.
SESSION_SECURE_COOKIE=true

# Codes are already on wherever APP_ENV=production. This line only states it out loud — do not set it false here,
# or an office sign-in opens on the password alone.
OTP_ENABLED=true
